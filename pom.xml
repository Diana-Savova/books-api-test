<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"

         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"

         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>books-api-test</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>API Test Framework</name>
    <description>API test automation framework using Maven, Groovy and Spock</description>
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <groovy.version>4.0.22</groovy.version>
        <spock.version>2.3-groovy-4.0</spock.version>
        <rest-assured.version>5.4.0</rest-assured.version>
        <!-- Versions pinned to address known CVEs:

                     - jackson 2.18.6  ........ fixes GHSA-72hv-8253-57qq (jackson-core DoS, 8.7)

                     - logback 1.5.32  ........ fixes GHSA-pr98-23f8-jwxv + 3 related (5.9/5.9/2.4/1.8)

                     - commons-lang3 3.18.0 ... fixes GHSA-j288-q9x7-2f5v (uncontrolled recursion, 6.5) -->
        <jackson.version>2.18.6</jackson.version>
        <logback.version>1.5.32</logback.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <allure.version>2.29.1</allure.version>
        <aspectj.version>1.9.22.1</aspectj.version>
        <allure-maven.version>2.15.2</allure-maven.version>
        <junit-bom.version>5.11.3</junit-bom.version>
        <gmavenplus-plugin.version>4.0.1</gmavenplus-plugin.version>
        <surefire-plugin.version>3.2.5</surefire-plugin.version>
        <!-- Overridable from command line / env vars -->
        <api.base.url>https://fakerestapi.azurewebsites.net</api.base.url>
        <api.basePath>/api/v1</api.basePath>
        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- Aligns junit-platform-* versions so Surefire and Spock see the same

                             JUnit Platform. Without this, transitive resolution can pick mismatched

                             versions and Surefire crashes with NoSuchMethodError at runtime. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Jackson BOM keeps every jackson-* artifact aligned and patches the

                             transitive jackson-core CVE (GHSA-72hv-8253-57qq). -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Pin transitive logback artifacts so vulnerable versions cannot leak in

                             via Rest-Assured / Groovy / other test deps. -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <!-- Force commons-lang3 to the patched version. Pulled in transitively by

                             Rest-Assured / Groovy / Spock; this override applies everywhere. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!-- IMPORTANT: allure-spock2 MUST come BEFORE spock-core on the classpath,

                     otherwise Spock's given/when/then blocks won't be picked up as report steps. -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-spock2</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Groovy -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>${groovy.version}</version>
        </dependency>
        <!-- Spock - includes spock.lang.Tag for JUnit Platform tag filtering. -->
        <dependency>
            <groupId>org.spockframework</groupId>
            <artifactId>spock-core</artifactId>
            <version>${spock.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Rest-Assured for HTTP. json-path is brought in transitively. -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Jackson for POJO <-> JSON marshalling.

                     Version comes from jackson-bom in dependencyManagement. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Logging - logback-classic brings slf4j-api transitively.

                     Version comes from dependencyManagement above. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <testSourceDirectory>src/test/groovy</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>${gmavenplus-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Surefire runs the Spock suite.

                             The -javaagent loads AspectJ, which is what Allure's @Step / @Attachment

                             annotations use under the hood. Without it, those annotations silently no-op.

                             Tag filtering is done at runtime via command line, e.g.:

                               mvn test -Dgroups=happy-path

                               mvn test -DexcludedGroups=negative -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <includes>
                        <include>**/*Spec.class</include>
                    </includes>
                    <systemPropertyVariables>
                        <api.base.url>${api.base.url}</api.base.url>
                        <api.basePath>${api.basePath}</api.basePath>
                        <allure.results.directory>${allure.results.directory}</allure.results.directory>
                    </systemPropertyVariables>
                    <argLine>-Xmx1024m -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"</argLine>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                    <!-- Surefire 3.x needs an explicit JUnit Platform launcher to
                    discover Spock tests. Without this, Surefire silently runs
                    zero tests. Version managed by junit-bom. -->
                    <dependency>
                        <groupId>org.junit.platform</groupId>
                        <artifactId>junit-platform-launcher</artifactId>
                        <version>1.11.3</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven.version}</version>
                <configuration>
                    <resultsDirectory>${allure.results.directory}</resultsDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
